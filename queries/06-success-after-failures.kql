// HIGH SEVERITY: successful logon from an IP that previously failed many times
let Failed = SecurityEvent
    | where EventID == 4625
    | summarize Fails = count() by IpAddress, TargetUserName;
SecurityEvent
| where EventID == 4624 and LogonType in (3, 10)
| join kind=inner Failed on IpAddress, TargetUserName
| where Fails > 10
| project TimeGenerated, Computer, IpAddress, TargetUserName, LogonType, Fails
| extend IPCustomEntity = IpAddress, HostCustomEntity = Computer
